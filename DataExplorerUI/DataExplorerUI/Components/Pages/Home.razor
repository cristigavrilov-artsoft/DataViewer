@page "/"
@rendermode InteractiveServer

<div class="container ">
    <div class="row justify-content-center">
        <div class="col-6 col-md-3">
            <NavLink class="nav-link" href="/albums">
                <div class="card text-center p-3"
                    style="cursor: pointer; border: none; background: none;">
                    <div class="card-body">
                        <img src="/folder.png" width="40" height="40" style="margin:0px 20px;" alt="folder image">
                        <h4 >Albums</h4>
                    </div>
                </div>
            </NavLink>
        </div>

        <div class="col-6 col-md-3">
             <NavLink class="nav-link" href="/posts">
            <div class="card text-center p-3"
                style="cursor: pointer; border: none; background: none;">
                <div class="card-body">
                    <img src="/folder.png" width="40" height="40" style="margin:0px 20px;" alt="folder image">
                    <h4>Posts</h4>
                </div>
            </div>
            </NavLink>
        </div>
    </div>
</div>
